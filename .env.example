# Copy to .env (ignored) and generate fresh random secrets. Do not use examples as production secrets.
DATABASE_PASSWORD=replace-with-at-least-64-random-hex-characters
DATABASE_ADMIN_PASSWORD=replace-with-separate-random-admin-password
MOAPAN_SECRET=replace-with-at-least-32-random-characters
PUBLIC_BASE_URL=http://localhost:8080
# false is only for loopback HTTP with synthetic accounts; production requires HTTPS and true.
COOKIE_SECURE=false

# Server collection interval floor (seconds); minimum supported value 300.
SOURCE_MIN_INTERVAL_SECONDS=300

# Optional Linux CPU translation overlay (no host ports, no paid API).
TRANSLATION_THREADS=2
TRANSLATION_CPUS=2
TRANSLATION_MEMORY=4g
TRANSLATION_TIMEOUT_SECONDS=300
TRANSLATION_KEY_FILE=./.local/translation/api.key

# For public/server mode, configure an approved domain/IP and matching HTTPS PUBLIC_BASE_URL.
# MOAPAN_PUBLIC_HOST=news.example.com
# MOAPAN_LISTEN_ADDRESS=0.0.0.0

# Internal Qwen3.5-4B classification service, enabled by start.sh.
CLASSIFICATION_THREADS=2
CLASSIFICATION_CPUS=2
CLASSIFICATION_MEMORY=4g
CLASSIFICATION_KEY_FILE=./.local/classification/api.key

# Required to enable signup/email recovery with the optional Compose mail overlay.
# Use an operator-controlled sender; example.test only works as a synthetic local sink.
# MAIL_FROM=no-reply@your-verified-domain.example
# MAIL_HOSTNAME=mail.your-verified-domain.example
# MAILBOX_SOURCE_PATH=/absolute/path/to/mail-box/smtp-receiver

# Existing, separately operated MailBox: use compose-mail-external.yaml instead of compose-mail.yaml.
# Public CA certificate only; never provide the CA/server private key to this application.
# MAIL_SMTP_HOST=mailbox-smtp-receiver
# MAIL_SMTP_PORT=25
# MAIL_SMTP_NETWORK=mailbox_default
# MAIL_SMTP_CA_FILE=./.local/mail/external/operator-ca.crt
