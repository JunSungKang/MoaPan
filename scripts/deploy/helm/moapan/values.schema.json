{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "publicHost",
    "existingSecret",
    "images"
  ],
  "properties": {
    "publicHost": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9.-]+$"
    },
    "existingSecret": {
      "type": "string",
      "minLength": 1
    },
    "images": {
      "type": "object",
      "required": [
        "app",
        "database",
        "proxy",
        "translator",
        "classifier"
      ],
      "properties": {
        "app": {
          "type": "string",
          "pattern": "^.+@sha256:[a-f0-9]{64}$"
        },
        "database": {
          "type": "string",
          "pattern": "^.+@sha256:[a-f0-9]{64}$"
        },
        "proxy": {
          "type": "string",
          "pattern": "^.+@sha256:[a-f0-9]{64}$"
        },
        "translator": {
          "type": "string",
          "pattern": "^.+@sha256:[a-f0-9]{64}$"
        },
        "classifier": {
          "type": "string",
          "pattern": "^.+@sha256:[a-f0-9]{64}$"
        }
      }
    },
    "migrationVersion": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "translationThreads": {
      "type": "string",
      "pattern": "^([1-9]|[1-5][0-9]|6[0-4])$"
    },
    "webReplicas": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "classificationThreads": {
      "type": "string",
      "pattern": "^([1-9]|[1-5][0-9]|6[0-4])$"
    }
  }
}
